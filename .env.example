POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/provider_ranking

HF_TOKEN=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5/latest
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

T1_DATA_DIR=data/t1
MIGRATIONS_DIR=migration
SYNC_INTERVAL_SECONDS=3600
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

HOST=0.0.0.0
PORT=8000

# Enable each provider independently
T1_LOCAL_PROVIDER=false
T1_WEB_PROVIDER=true
CLOUDRU_WEB_PROVIDER=true
YANDEX_CLOUD_WEB_PROVIDER=true
SELECTEL_WEB_PROVIDER=true
VK_CLOUD_WEB_PROVIDER=false

# Yandex Cloud search index sync (vector store)
YANDEX_SEARCH_INDEX_SYNC=false
YANDEX_VECTOR_STORE_ID=
